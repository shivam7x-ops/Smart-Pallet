# ==========================================
# SMART PALLET TRACKER - BACKEND CONFIG
# ==========================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Security & IoT Device Authentication
# This key must match the API key configured on your ESP32 device
API_SECRET_KEY=SMART_PALLET_SECRET_KEY_2026
JWT_SECRET=SMART_PALLET_JWT_SUPER_SECRET_98765

# Database Configuration
# Uses SQLite locally by default (stored at backend/iot_telemetry.db)
DATABASE_URL=sqlite:///./iot_telemetry.db

# Supabase Cloud Database Configuration (optional / cloud sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-anon-key

# Firebase Realtime Database URL for cloud sync
FIREBASE_RTDB_URL=https://smart-pallet-a6d21-default-rtdb.firebaseio.com

# Telemetry Alert Thresholds
TEMP_HIGH_THRESHOLD=35.0
TEMP_LOW_THRESHOLD=5.0
HUMIDITY_HIGH_THRESHOLD=80.0
SHOCK_THRESHOLD_G=2.2
DEVICE_OFFLINE_SECONDS=60

